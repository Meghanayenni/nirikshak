# NIRIKSHAK configuration. Copy to .env and adjust.
# .env is gitignored — never commit real values.

# Confidence below this threshold is coerced to UNKNOWN and routed to the
# administrator training workflow (CLAUDE.md Rule 3). Provisional until the
# calibrator is fitted at P9 — see R7 and R8.
NIRIKSHAK_CONFIDENCE_THRESHOLD=0.85

# When true, every outbound network call is hard-disabled, including model
# downloads. The system fails closed rather than degrading silently (Rule 6).
NIRIKSHAK_AIRGAP=false

# SQLite database location, relative to the repository root.
NIRIKSHAK_DB_PATH=nirikshak.db
