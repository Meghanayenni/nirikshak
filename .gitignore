# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Project-local virtual environment (R2)
.venv/

# Local database and uploaded configuration files.
# Configuration files are sensitive data (CLAUDE.md §9) and must never be
# committed, even from the sample corpus workflow.
*.db
*.db-journal
uploads/

# Runtime-generated vendor packs (P11, decision D45).
# `packs/trained/` holds packs api/train/ compiled from administrator
# confirmations, plus the activation record naming which version is in force.
# Both are DEPLOYMENT STATE, not repository content: committing them would blur
# the one distinction the two pack roots exist to keep — what a person wrote and
# a reviewer read, versus what this deployment learned.
packs/trained/*
!packs/trained/.gitkeep

# Environment
.env

# Frontend (scaffolded at P13)
ui/node_modules/
ui/dist/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# CIS Benchmarks — never held in this repository (ADR 0052).
# A CIS Benchmark's own terms say it may not be hosted on a third-party site,
# and this repository has a public remote. The benchmark is read from an
# operator-supplied path OUTSIDE the tree; only its recommendation numbers,
# edition and sha256 are recorded, in rules/frameworks/. This entry is the
# accident guard; tests/architecture/test_cis_material_is_not_held.py is the
# check, and it fails on an ignored copy too.
*CIS*Benchmark*
*CIS*benchmark*
*cis*benchmark*
*CIS_Cisco_IOS*
