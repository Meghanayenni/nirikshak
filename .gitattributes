* text=auto eol=lf

# Binary assets. `text=auto` guesses well, but a corrupted font is a silent
# failure that only shows up as a fallback typeface on somebody else's checkout.
*.woff2 binary
*.woff binary
*.pdf binary

# Third-party source documents held for content addressing (ADR 0052). Their
# sha256 is recorded in rules/frameworks/, so git must store and check out the
# exact published bytes — no line-ending normalisation, ever.
docs/sources/** -text
